# IQGS RAG Service — file mẫu cấu hình (pgvector + internal API)
# Sao chép: copy .env.example .env  (Windows) hoặc cp .env.example .env (Linux/macOS)

# --- PostgreSQL (dùng chung với IQGS Backend) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/iqgs

# --- Backend callback ---
BACKEND_INTERNAL_BASE_URL=http://localhost:5000
# Header: X-Internal-Api-Key — BẮT BUỘC, không có bypass
INTERNAL_API_KEY=internal-secret

# --- Ollama (LLM + Embedding) ---
OLLAMA_BASE_URL=http://localhost:11434/v1
CHAT_MODEL=gemma4b:cloud
EMBEDDING_MODEL=nomic-embed-text
# Phải khớp RagSettings:EmbeddingDimension trên Backend và vector(N) trong migration
EMBEDDING_DIMENSION=768

# --- Chunking ---
CHUNK_SIZE=1200
CHUNK_OVERLAP=200

# --- Retrieval ---
TOP_K_SYSTEM=5
TOP_K_HR=5

# --- HTTP timeout (blob download + backend callback) ---
REQUEST_TIMEOUT_SECONDS=120

# --- Debug (chỉ dev) ---
# true = trả rawAnswer trong generate-questions response
DEBUG=false
